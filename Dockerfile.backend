# Imagen del backend (API + datos compartidos)
FROM node:22-alpine

WORKDIR /app

# Python es necesario para la impresión de etiquetas ZPL (server/printer.js usa spawn('python')).
# Chromium es necesario para la generación de PDFs con Puppeteer.
# postgresql-client provee pg_dump y pg_restore para respaldos nativos de PostgreSQL.
RUN apk add --no-cache python3 chromium nss freetype harfbuzz ca-certificates ttf-freefont postgresql-client

# Copia e instala dependencias del servidor
COPY server/package*.json ./server/
RUN cd server && npm install --omit=dev

# Copia el código del servidor y los módulos compartidos (shared/)
COPY server ./server
COPY shared ./shared

# Genera el cliente Prisma desde el esquema (server/prisma/schema.prisma)
RUN cd server && npx prisma generate

ENV PORT=3000
ENV DATA_DIR=/app/data
ENV PYTHON=python3
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

EXPOSE 3000

# Los datos persisten en el volumen /app/data
VOLUME ["/app/data"]

CMD ["sh", "-c", "cd server && npx prisma db push --skip-generate && cd .. && node server/index.js"]