# Generar secretos con: node scripts/setup-env.mjs
PG_PASSWORD=
JWT_SECRET=
BACKUP_ENCRYPTION_KEY=
PRINT_BRIDGE_TOKEN=
APP_BIND_IP=127.0.0.1
APP_PORT=8081
# Docker Desktop: host.docker.internal. Docker Engine en WSL: IP de Windows.
PRINT_BRIDGE_HOST=host.docker.internal
# Copias cifradas automáticas fuera del disco de Docker. Puede apuntar a otro disco.
BACKUP_HOST_DIR=./backups
LABEL_PRINTER_NAME=
# El primer ingreso obliga a cambiar esta contraseña.
INITIAL_ADMIN_PASSWORD=admin123
# HTTPS local opcional: npm run deploy habilita el perfil si ENABLE_HTTPS=1.
ENABLE_HTTPS=0
APP_HOST=localhost
HTTPS_BIND_IP=127.0.0.1
