{
  "name": "service-center",
  "private": true,
  "version": "1.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ui": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:server": "cd server && cross-env PORT=4000 node index.js",
    "build": "vite build",
    "build:windows": "node scripts/windows/build.mjs",
    "test:windows": "node scripts/windows/verify-package.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:integration": "node --test tests/integration/workflow.mjs",
    "test:local": "npm run build && node scripts/verify-local.mjs",
    "test:browser": "npm run build && node scripts/verify-local.mjs --ui",
    "check": "npm run lint && npm test && npm run build",
    "setup:env": "node scripts/setup-env.mjs",
    "deploy": "node scripts/deploy.mjs",
    "backup": "node scripts/backup.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "cross-env": "^10.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "^5.0.2"
  }
}
